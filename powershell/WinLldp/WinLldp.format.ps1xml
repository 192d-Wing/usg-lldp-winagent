<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>WinLldp.Neighbor</Name>
      <ViewSelectedBy><TypeName>WinLldp.Neighbor</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Interface</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>SystemName</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>PortId</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>ManagementIPv4</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Caps</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>TTL</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>InterfaceAlias</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SystemName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PortId</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.ManagementIPv4 -join ','</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Capabilities -join ','</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>TtlRemaining</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinLldp.Interface</Name>
      <ViewSelectedBy><TypeName>WinLldp.Interface</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>InterfaceAlias</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Kind</Label><Width>17</Width></TableColumnHeader>
          <TableColumnHeader><Label>Mode</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Connected</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>MacAddress</Label><Width>17</Width></TableColumnHeader>
          <TableColumnHeader><Label>Neighbors</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>InterfaceAlias</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Mode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Connected</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MacAddress</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Neighbors</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinLldp.Statistic</Name>
      <ViewSelectedBy><TypeName>WinLldp.Statistic</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>InterfaceAlias</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>RxFrames</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>TxFrames</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Discarded</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Errors</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Ageouts</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Unrecognized</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>InterfaceAlias</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RxFramesTotal</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TxFramesTotal</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RxFramesDiscarded</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RxFramesErrors</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RxAgeouts</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RxTlvsUnrecognized</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinLldp.ServiceStatus</Name>
      <ViewSelectedBy><TypeName>WinLldp.ServiceStatus</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>ComputerName</PropertyName></ListItem>
              <ListItem><PropertyName>Version</PropertyName></ListItem>
              <ListItem><PropertyName>Uptime</PropertyName></ListItem>
              <ListItem><PropertyName>NpcapVersion</PropertyName></ListItem>
              <ListItem><PropertyName>BackendStatus</PropertyName></ListItem>
              <ListItem><PropertyName>ConfigPath</PropertyName></ListItem>
              <ListItem><PropertyName>ConfigLoaded</PropertyName></ListItem>
              <ListItem><PropertyName>PolicyApplied</PropertyName></ListItem>
              <ListItem><PropertyName>ChassisId</PropertyName></ListItem>
              <ListItem><PropertyName>SystemName</PropertyName></ListItem>
              <ListItem><PropertyName>InterfacesManaged</PropertyName></ListItem>
              <ListItem><PropertyName>InterfacesKnown</PropertyName></ListItem>
              <ListItem><PropertyName>Neighbors</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
